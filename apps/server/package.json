    "@colyseus/redis-presence": "^0.18.2",
    "@colyseus/ws-transport": "^0.18.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@smart-rot/game-engines": "workspace:*",
    "@smart-rot/rating-glicko2": "workspace:*",
    "@smart-rot/shared-types": "workspace:*",
    "express": "^5.0.0",
    "fastify": "^5.12.1",
    "ioredis": "^5.4.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
