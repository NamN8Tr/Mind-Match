# Copy to .env and fill in real values for local development.
# .env is gitignored; docker-compose.yml (repo root) provides matching local Postgres/Redis.

DATABASE_URL="postgresql://smartrot:smartrot@localhost:5432/smartrot?schema=public"
REDIS_URL="redis://localhost:6379"

# From your Clerk dashboard (https://dashboard.clerk.com) -> API Keys.
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

PORT=4000
# Colyseus runs on its own http.Server/port rather than sharing Fastify's — see
# the comment on env.colyseusPort in src/env.ts for why.
COLYSEUS_PORT=4001

# The Next.js dev server's origin — must match exactly (scheme + host + port)
# for the browser to allow the REST API calls apps/web makes cross-origin.
WEB_ORIGIN="http://localhost:3000"

# Optional: Spider solver binary that refills the board pool. Defaults to
# tools/spider-solver/bin/spider-solver (built by `pnpm build:spider-solver`).
# SPIDER_SOLVER_PATH="/absolute/path/to/spider-solver"
