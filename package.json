{
  "name": "smart-rot",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "launch": "./scripts/dev.sh",
    "build": "sh tools/spider-solver/build.sh && turbo run build",
    "build:spider-solver": "sh tools/spider-solver/build.sh",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @smart-rot/server db:generate",
    "db:migrate": "pnpm --filter @smart-rot/server db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
